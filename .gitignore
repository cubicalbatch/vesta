# ---- Project data (never commit) ----
# ZIM archives are large (~50 MB and ~317 MB) — always local.
data/zims/*.zim
# Downloaded/embedding models and runtime caches.
data/models/
data/cache/
# SQLite databases (system of record) and their sidecar files.
*.db
*.db-wal
*.db-shm
data/vesta.db*
# Per-archive indexing resume sidecars (written by `vesta index`).
data/.index_progress_*.json
# Local dev/bench run state (bench DBs, downloaded models, etc.). Never commit.
data/
data2/
# Retrieval-context snapshots (§20 mode-2 replay) — large, regenerable artifacts.
snapshots/

